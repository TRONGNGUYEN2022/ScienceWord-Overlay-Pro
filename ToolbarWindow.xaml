<Window x:Class="ScienceWordOverlay.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScienceWord Overlay Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Left="14"
        Top="6">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#5A94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5.5,2.5"/>
            <Setter Property="Margin" Value="1.5,0"/>
            <Setter Property="FontSize" Value="10.2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F00F172A" BorderBrush="#B460A5FA" BorderThickness="1.5" CornerRadius="10" Padding="7,5" Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- HANG 1: THANH CHINH SIEU GON (2 MENU VE 2D / VE 3D + CHON NEN) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⋮⋮ W² v9" Foreground="#FBBF24" FontWeight="ExtraBold" FontSize="11.5"
                           VerticalAlignment="Center" Margin="0,0,5,0" Cursor="SizeAll"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>

                <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0">
                    <TextBlock x:Name="TxtTargetApp" Text="Đích: Tự động" Foreground="#7DD3FC" FontSize="10.2" FontWeight="Bold" MaxWidth="112" TextTrimming="CharacterEllipsis"/>
                </Border>

                <ToggleButton x:Name="BtnPassthrough" Content="Xuyên chuột" Padding="6,2.5" Margin="0,0,4,0"
                              FontSize="10.3" FontWeight="Bold" Cursor="Hand"
                              Checked="BtnPassthrough_Checked" Unchecked="BtnPassthrough_Unchecked"
                              Background="#334155" Foreground="White" BorderBrush="#94A3B8"/>

                <Button Style="{StaticResource ActionBtn}" Content="Chọn" Click="QuickSelect_Click"/>
                <Button x:Name="BtnMenu2D" Style="{StaticResource ActionBtn}" Content="📐 Vẽ 2D ▾" Background="#1D4ED8" BorderBrush="#93C5FD" Padding="8,3" FontWeight="Bold" Click="BtnMenu2D_Click"/>
                <Button x:Name="BtnMenu3D" Style="{StaticResource ActionBtn}" Content="🧊 Vẽ 3D ▾" Background="#7C3AED" BorderBrush="#C4B5FD" Padding="8,3" FontWeight="Bold" Click="BtnMenu3D_Click"/>
                <Button x:Name="BtnMenuBg" Style="{StaticResource ActionBtn}" Content="🎨 Nền: Trong suốt ▾" Background="#0F766E" BorderBrush="#5EEAD4" Padding="7,3" Click="BtnMenuBg_Click"/>

                <TextBlock x:Name="TxtActiveTool" Text="Đoạn thẳng" Foreground="#FDE68A" FontSize="10.2"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,5,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>

                <Button Style="{StaticResource ActionBtn}" Content="↩" ToolTip="Hoàn tác (Ctrl+Z)" Click="BtnUndo_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="↪" ToolTip="Làm lại (Ctrl+Y)" Click="BtnRedo_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Xóa" Click="BtnClear_Click"/>
                <Button x:Name="BtnHistoryEdit" Style="{StaticResource ActionBtn}" Content="Sửa cũ ▾" Background="#4F46E5" BorderBrush="#A5B4FC" Click="BtnHistoryEdit_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Chèn App" Background="#2563EB" BorderBrush="#93C5FD" FontWeight="Bold" Click="BtnInsertApp_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Copy" Background="#10B981" Foreground="#052E16" BorderBrush="#6EE7B7" FontWeight="Bold" Click="BtnCopyPng_Click"/>
                <Button x:Name="BtnCollapse" Style="{StaticResource ActionBtn}" Content="▲" Width="22" Margin="3,0,1,0" Click="BtnCollapse_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="✕" Width="22" Background="#DC2626" BorderBrush="#F87171" Click="BtnClose_Click"/>
            </StackPanel>

            <!-- HANG 2: THUOC TINH NET/TO + DIEU KHIEN 3D TACH KHOI & QUAY -->
            <StackPanel x:Name="Row2Panel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Nét:" Foreground="#CBD5E1" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#0F172A" BorderBrush="White" Tag="#0F172A" Click="StrokeColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#FFFFFF" BorderBrush="#94A3B8" Tag="#FFFFFF" Click="StrokeColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#FDE047" BorderBrush="White" Tag="#FDE047" Click="StrokeColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#38BDF8" BorderBrush="White" Tag="#38BDF8" Click="StrokeColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0,4,0" Background="#EF4444" BorderBrush="White" Tag="#EF4444" Click="StrokeColor_Click"/>

                <ComboBox x:Name="CbPenType" Width="64" Margin="0,0,3,0" SelectedIndex="0" SelectionChanged="CbPenType_SelectionChanged" FontSize="10">
                    <ComboBoxItem Content="Bút bi" Tag="solid"/>
                    <ComboBoxItem Content="Bút chì" Tag="pencil"/>
                    <ComboBoxItem Content="Bút cọ" Tag="brush"/>
                    <ComboBoxItem Content="Nét đứt" Tag="dash"/>
                    <ComboBoxItem Content="Dạ quang" Tag="highlighter"/>
                </ComboBox>

                <ComboBox x:Name="CbWidth" Width="44" Margin="0,0,5,0" SelectedIndex="1" SelectionChanged="CbWidth_SelectionChanged" FontSize="10">
                    <ComboBoxItem Content="1.5" Tag="1.5"/>
                    <ComboBoxItem Content="2.4" Tag="2.4"/>
                    <ComboBoxItem Content="4.0" Tag="4.0"/>
                    <ComboBoxItem Content="6.0" Tag="6.0"/>
                </ComboBox>

                <TextBlock Text="Tô:" Foreground="#CBD5E1" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#FACC15" BorderBrush="White" Tag="#FACC15" Click="FillColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#38BDF8" BorderBrush="White" Tag="#38BDF8" Click="FillColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0" Background="#10B981" BorderBrush="White" Tag="#10B981" Click="FillColor_Click"/>
                <Button Width="14" Height="14" Margin="1,0,3,0" Background="#EF4444" BorderBrush="White" Tag="#EF4444" Click="FillColor_Click"/>

                <ComboBox x:Name="CbPattern" Width="66" Margin="0,0,3,0" SelectedIndex="0" SelectionChanged="CbPattern_SelectionChanged" FontSize="10">
                    <ComboBoxItem Content="Tô đặc" Tag="solid"/>
                    <ComboBoxItem Content="Gạch chéo" Tag="hatch"/>
                    <ComboBoxItem Content="Ca rô" Tag="cross"/>
                    <ComboBoxItem Content="Chấm bi" Tag="dots"/>
                </ComboBox>

                <Slider x:Name="SlOpacity" Width="40" Minimum="10" Maximum="85" Value="42" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Độ mờ màu tô / thiết diện" ValueChanged="SlOpacity_ValueChanged"/>

                <Border Background="#1E293B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="5" Padding="4,1" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAutoSpin3D" Style="{StaticResource ActionBtn}" Content="▶ Quay 3D" Background="#B45309" Click="BtnAutoSpin3D_Click"/>
                        <TextBlock x:Name="TxtSplit3D" Text="Tách: 0%" Foreground="#FDE68A" FontSize="10" VerticalAlignment="Center" Margin="4,0,2,0"/>
                        <Slider x:Name="SlSplit3D" Width="62" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="SlSplit3D_ValueChanged"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Ẩn 3D" Margin="3,0,0,0" Click="BtnClearSolid3D_Click"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource ActionBtn}" Content="Đọc Office" Background="#0D9488" BorderBrush="#5EEAD4" Click="BtnSyncOffice_Click"/>
                <CheckBox Content="Nền trắng" IsChecked="False" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center" Margin="3,0,2,0" Checked="ChkWhiteBg_Changed" Unchecked="ChkWhiteBg_Changed"/>
                <Button Style="{StaticResource ActionBtn}" Content="PNG" Background="#0284C7" BorderBrush="#7DD3FC" Click="BtnSavePng_Click"/>
            </StackPanel>

            <!-- HANG 3: TICH PHAN NHIEU CAN & TACH MAU S / V (TU HIEN KHI DOC OFFICE / BAT TICH PHAN) -->
            <StackPanel x:Name="Row3Panel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock Text="Tích phân:" Foreground="#FBBF24" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Button x:Name="BtnRevArea" Style="{StaticResource ActionBtn}" Content="Tô S" Background="#2563EB" Click="BtnRevArea_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="+ Cận" Background="#0EA5E9" BorderBrush="#BAE6FD" ToolTip="Thêm cận chia nhiều miền S1, S2... (hoặc Shift+Click trên trục)" Click="BtnAddBound_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="- Cận" Click="BtnRemoveBound_Click"/>
                <Button x:Name="BtnRev3D" Style="{StaticResource ActionBtn}" Content="Quay V" Click="BtnRev3D_Click"/>
                <Button x:Name="BtnRevAnim" Style="{StaticResource ActionBtn}" Content="▶ 360°" Background="#B45309" Click="BtnRevAnim_Click"/>
                <TextBlock x:Name="TxtRevAngle" Text="360°" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <Slider x:Name="SlRevAngle" Width="54" Minimum="0" Maximum="360" Value="360" VerticalAlignment="Center" Margin="0,0,4,0" ValueChanged="SlRevAngle_ValueChanged"/>
                <Button x:Name="BtnColorArea" Style="{StaticResource ActionBtn}" Content="Màu S" Background="#EF4444" BorderBrush="#FCA5A5" Click="BtnColorArea_Click"/>
                <Button x:Name="BtnColorVol" Style="{StaticResource ActionBtn}" Content="Màu V" Background="#3B82F6" BorderBrush="#93C5FD" Click="BtnColorVol_Click"/>
                <CheckBox Content="Nắp" IsChecked="True" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Center" Margin="3,0,3,0" Checked="ChkRevCaps_Changed" Unchecked="ChkRevCaps_Changed"/>
                <Button Style="{StaticResource ActionBtn}" Content="Đổi trục" Click="BtnRevSwap_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Ẩn S/V" Click="BtnRevClear_Click"/>
                <Border Background="#1E293B" BorderBrush="#34D399" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="4,0,0,0">
                    <TextBlock x:Name="TxtMetrics" Text="S &amp; V" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>