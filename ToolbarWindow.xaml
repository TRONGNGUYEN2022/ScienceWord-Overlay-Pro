<Window x:Class="ScienceWordOverlay.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScienceWord Overlay Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Left="90"
        Top="14">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="#DC1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#5A94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF3B82F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F59E0B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FDE68A"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#5A94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#EC0F172A" BorderBrush="#B460A5FA" BorderThickness="1.5" CornerRadius="12" Padding="10,7" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- HANG 1: CONG CU VE CHINH -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⋮⋮ W² Overlay" Foreground="#FBBF24" FontWeight="ExtraBold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>

                <ToggleButton x:Name="BtnPassthrough" Content="Xuyên chuột" Padding="8,4" Margin="2,0,6,0"
                              FontSize="11" FontWeight="Bold" Cursor="Hand"
                              Checked="BtnPassthrough_Checked" Unchecked="BtnPassthrough_Unchecked"
                              Background="#334155" Foreground="White" BorderBrush="#94A3B8"/>

                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Chọn" Tag="select" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Điểm" Tag="point" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Đoạn" Tag="segment" IsChecked="True" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Nét đứt" Tag="dashed" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Vectơ" Tag="vector" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Tam giác" Tag="triangle" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="HCN" Tag="rect" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Tròn" Tag="circle" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="T.Điểm" Tag="midpoint" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Đ.Cao ⊥" Tag="altitude" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Tô miền" Tag="fill_area" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Tô góc" Tag="fill_angle" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="G.Vuông" Tag="right_angle" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Bút" Tag="pen" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Dạ quang" Tag="highlighter" Click="Tool_Click"/>
                <RadioButton Style="{StaticResource ToolBtn}" GroupName="Tools" Content="Chữ" Tag="text" Click="Tool_Click"/>

                <Button x:Name="BtnCollapse" Style="{StaticResource ActionBtn}" Content="▲" Width="28" Margin="6,0,2,0" Click="BtnCollapse_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="✕" Width="28" Background="#DC2626" BorderBrush="#F87171" Click="BtnClose_Click"/>
            </StackPanel>

            <!-- HANG 2: MAU NET, MAU TO, KIEU TO, 3D & XUAT WORD -->
            <StackPanel x:Name="Row2Panel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="Nét:" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#0F172A" BorderBrush="White" Tag="#0F172A" Click="StrokeColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#1D4ED8" BorderBrush="White" Tag="#1D4ED8" Click="StrokeColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#DC2626" BorderBrush="White" Tag="#DC2626" Click="StrokeColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#059669" BorderBrush="White" Tag="#059669" Click="StrokeColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0,6,0" Background="#FFFFFF" BorderBrush="#94A3B8" Tag="#FFFFFF" Click="StrokeColor_Click"/>

                <ComboBox x:Name="CbWidth" Width="62" Margin="0,0,8,0" SelectedIndex="1" SelectionChanged="CbWidth_SelectionChanged" FontSize="11">
                    <ComboBoxItem Content="1.5 px" Tag="1.5"/>
                    <ComboBoxItem Content="2.4 px" Tag="2.4"/>
                    <ComboBoxItem Content="4.0 px" Tag="4.0"/>
                    <ComboBoxItem Content="6.0 px" Tag="6.0"/>
                </ComboBox>

                <TextBlock Text="Tô:" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#3B82F6" BorderBrush="White" Tag="#3B82F6" Click="FillColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#F59E0B" BorderBrush="White" Tag="#F59E0B" Click="FillColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#10B981" BorderBrush="White" Tag="#10B981" Click="FillColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0" Background="#EF4444" BorderBrush="White" Tag="#EF4444" Click="FillColor_Click"/>
                <Button Width="18" Height="18" Margin="1,0,6,0" Background="#FDE047" BorderBrush="White" Tag="#FDE047" Click="FillColor_Click"/>

                <ComboBox x:Name="CbPattern" Width="92" Margin="0,0,6,0" SelectedIndex="0" SelectionChanged="CbPattern_SelectionChanged" FontSize="11">
                    <ComboBoxItem Content="Tô đặc" Tag="solid"/>
                    <ComboBoxItem Content="Gạch chéo ///" Tag="hatch"/>
                    <ComboBoxItem Content="Ca rô ###" Tag="cross"/>
                    <ComboBoxItem Content="Chấm bi •••" Tag="dots"/>
                </ComboBox>

                <TextBlock Text="Mờ:" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <Slider x:Name="SlOpacity" Width="58" Minimum="10" Maximum="80" Value="30" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="SlOpacity_ValueChanged"/>

                <Button Style="{StaticResource ActionBtn}" Content="Chóp 3D" Click="PresetPyramid_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Lập phương" Click="PresetCube_Click"/>

                <CheckBox Content="Thước/Compa" IsChecked="True" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0" Checked="ChkTools_Changed" Unchecked="ChkTools_Changed"/>
                <CheckBox Content="Tên điểm" IsChecked="True" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0" Checked="ChkLabels_Changed" Unchecked="ChkLabels_Changed"/>
                <CheckBox Content="Nền trắng Copy" IsChecked="False" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="2,0,6,0" Checked="ChkWhiteBg_Changed" Unchecked="ChkWhiteBg_Changed"/>

                <Button Style="{StaticResource ActionBtn}" Content="↩" ToolTip="Hoàn tác (Ctrl+Z)" Click="BtnUndo_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="↪" ToolTip="Làm lại (Ctrl+Y)" Click="BtnRedo_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Xóa hết" Click="BtnClear_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Copy vào Word" Background="#10B981" Foreground="#052E16" BorderBrush="#6EE7B7" FontWeight="Bold" Click="BtnCopyWord_Click"/>
                <Button Style="{StaticResource ActionBtn}" Content="Lưu PNG" Background="#0284C7" BorderBrush="#7DD3FC" Click="BtnSavePng_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
