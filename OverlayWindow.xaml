<Window x:Class="ScienceWordOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScienceWordOverlay"
        Title="ScienceWord Overlay Pro"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Normal"
        ShowInTaskbar="False">
    <Grid>
        <local:OverlaySurface x:Name="Surface"/>
        <Canvas x:Name="FloatingUiLayer">
            <Border x:Name="ContextMenuBar" Visibility="Collapsed"
                    Background="#F20F172A" BorderBrush="#60A5FA" BorderThickness="1.3"
                    CornerRadius="8" Padding="5,3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel x:Name="ContextMenuItems" Orientation="Vertical"/>
            </Border>
        </Canvas>
    </Grid>
</Window>